{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "firstperson_lefthand",
        "model": {
          "type": "minecraft:model",
          "model": "zedaph:item/sheep_first_person_32"
        }
      },
      {
        "when": "firstperson_righthand",
        "model": {
          "type": "minecraft:model",
          "model": "zedaph:item/sheep_first_person_32"
        }
      },
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "zedaph:item/sheep_hotbar_item_32"
        }
      },
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:model",
          "model": "zedaph:item/sheep_first_person_32"
        }
      },
	  {
        "when": "on_shelf",
        "model": {
          "type": "minecraft:model",
          "model": "zedaph:item/sheep_first_person_32"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "zedaph:item/sheep_card_back"
    }
  }
}
